            },
            {
              "name": "400 - Name en blanco",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{baseUrl}}/api/examples" },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"\",\n  \"description\": \"Descripción\"\n}"
                }
              },
              "status": "Bad Request",
