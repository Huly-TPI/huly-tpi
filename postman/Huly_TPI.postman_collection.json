    {
      "name": "Risk Words",
      "description": "Gestión de palabras de riesgo emocional utilizadas como contexto para el análisis de IA.\n\nSeveridades válidas: LOW | MEDIUM | HIGH",
      "item": [
        {
          "name": "Crear palabra de riesgo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/risk-words",
              "host": ["{{baseUrl}}"],
              "path": ["api", "risk-words"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"word\": \"suicidio\",\n  \"description\": \"Indicador directo de ideación suicida\",\n  \"severity\": \"HIGH\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Crea una nueva palabra de riesgo emocional.\n\n**Respuesta exitosa:** 201 Created\n**Errores posibles:**\n- 400 si falta word o severity, o superan el largo máximo\n- 409 si la palabra ya existe"
          },
          "response": [
            {
              "name": "201 - Creada exitosamente",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{baseUrl}}/api/risk-words" },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"word\": \"suicidio\",\n  \"description\": \"Indicador directo de ideación suicida\",\n  \"severity\": \"HIGH\"\n}"
                }
              },
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": 1,\n  \"word\": \"suicidio\",\n  \"description\": \"Indicador directo de ideación suicida\",\n  \"severity\": \"HIGH\",\n  \"active\": true\n}"
            },
            {
              "name": "400 - Validación fallida",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{baseUrl}}/api/risk-words" },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"word\": \"\",\n  \"severity\": \"HIGH\"\n}"
                }
              },
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"timestamp\": \"2025-01-01T00:00:00\",\n  \"status\": 400,\n  \"error\": \"Bad Request\",\n  \"message\": \"Error de validación\",\n  \"errors\": {\n    \"word\": \"La palabra es obligatoria\"\n  }\n}"
            },
            {
              "name": "409 - Palabra duplicada",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{baseUrl}}/api/risk-words" },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"word\": \"suicidio\",\n  \"severity\": \"HIGH\"\n}"
                }
              },
              "status": "Conflict",
              "code": 409,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"timestamp\": \"2025-01-01T00:00:00\",\n  \"status\": 409,\n  \"error\": \"Conflict\",\n  \"message\": \"Ya existe una palabra de riesgo con el valor: suicidio\"\n}"
            }
          ]
        },
        {
          "name": "Actualizar palabra de riesgo",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/risk-words/{{riskWordId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "risk-words", "{{riskWordId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"word\": \"autolesión\",\n  \"description\": \"Indicador de conducta autolesiva\",\n  \"severity\": \"HIGH\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Actualiza todos los campos de una palabra de riesgo existente.\n\n**Respuesta exitosa:** 200 OK\n**Errores posibles:**\n- 400 si falta word o severity\n- 404 si el id no existe\n- 409 si el nuevo valor ya pertenece a otro registro"
          },
          "response": [
            {
              "name": "200 - Actualizada exitosamente",
              "originalRequest": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{baseUrl}}/api/risk-words/1" },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"word\": \"autolesión\",\n  \"description\": \"Indicador de conducta autolesiva\",\n  \"severity\": \"HIGH\"\n}"
                }
              },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": 1,\n  \"word\": \"autolesión\",\n  \"description\": \"Indicador de conducta autolesiva\",\n  \"severity\": \"HIGH\",\n  \"active\": true\n}"
            },
            {
              "name": "404 - No encontrada",
              "originalRequest": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{baseUrl}}/api/risk-words/999" },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"word\": \"autolesión\",\n  \"severity\": \"HIGH\"\n}"
                }
              },
              "status": "Not Found",
              "code": 404,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"timestamp\": \"2025-01-01T00:00:00\",\n  \"status\": 404,\n  \"error\": \"Not Found\",\n  \"message\": \"Palabra de riesgo no encontrada con id: 999\"\n}"
            },
            {
              "name": "409 - Conflicto con otro registro",
              "originalRequest": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{baseUrl}}/api/risk-words/1" },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"word\": \"ansiedad\",\n  \"severity\": \"LOW\"\n}"
                }
              },
              "status": "Conflict",
              "code": 409,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"timestamp\": \"2025-01-01T00:00:00\",\n  \"status\": 409,\n  \"error\": \"Conflict\",\n  \"message\": \"Ya existe una palabra de riesgo con el valor: ansiedad\"\n}"
            }
          ]
        },
        {
          "name": "Eliminar palabra de riesgo",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/risk-words/{{riskWordId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "risk-words", "{{riskWordId}}"]
            },
            "description": "Elimina físicamente una palabra de riesgo por su id.\n\n**Respuesta exitosa:** 204 No Content\n**Errores posibles:**\n- 404 si el id no existe"
          },
          "response": [
