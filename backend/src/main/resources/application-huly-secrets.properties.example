#SERVER
PORT=8080

#CORS
FRONTEND_URL=http://localhost:5173

#DATABASE (PostgreSQL local del docker-compose)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/huly
SPRING_DATASOURCE_USERNAME=huly_user
SPRING_DATASOURCE_PASSWORD=huly_pass

## DATABASE - Render (postgres remoto)
#spring.datasource.url=jdbc:postgresql://your-host.render.com:5432/your_db
#spring.datasource.username=your_render_username
#spring.datasource.password=your_render_password

#SSL (solo necesario si server.ssl.enabled=true)
SSL_KEY_STORE_PASSWORD=your_ssl_keystore_password

ANTHROPIC_API_KEY=your_anthropic_api_key

# OPENAI EMBEDDINGS / PGVECTOR
# Anthropic se usa para chat. OpenAI se usa para generar embeddings.
OPENAI_API_KEY=your_openai_api_key
AI_EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE_TYPE=pgvector
VECTOR_EMBEDDING_DIMENSION=1024
VECTOR_MEMORY_MIN_CONTENT_LENGTH=12
VECTOR_MEMORY_MAX_CONTENT_LENGTH=4000
VECTOR_MEMORY_DEFAULT_LIMIT=5
VECTOR_MEMORY_MAX_LIMIT=20
VECTOR_MEMORY_SIMILARITY_THRESHOLD=0.65
